<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/pg_background</item>
        <item name="android:colorAccent">@color/pg_accent</item>
        <item name="android:colorControlActivated">@color/pg_accent</item>
        <item name="android:colorControlHighlight">@color/pg_accent_ripple</item>
        <item name="android:colorControlNormal">@color/pg_text_muted</item>
        <item name="android:colorButtonNormal">@color/pg_surface_raised</item>
        <item name="android:textColorPrimary">@color/pg_text_primary</item>
        <item name="android:textColorSecondary">@color/pg_text_secondary</item>
        <item name="android:buttonStyle">@style/Widget.PocketGameplay.Button</item>
        <item name="android:editTextBackground">@drawable/bg_input</item>
        <item name="android:navigationBarColor">@color/pg_system_bar</item>
        <item name="android:statusBarColor">@color/pg_system_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.PocketGameplay.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/pg_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.PocketGameplay.Button.Primary" parent="@style/Widget.PocketGameplay.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/pg_on_accent</item>
    </style>
</resources>